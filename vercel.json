{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "qa-*": true
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "crons": [
    {
      "path": "/api/cron/reconcile",
      "schedule": "35 15 * * *"
    },
    {
      "path": "/api/cron/analytics-maintenance",
      "schedule": "47 0 * * *"
    }
  ]
}
