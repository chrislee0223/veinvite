{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "icn1"
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "qa-*": true
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "env": {
    "SYBIL_B3TR_OBSERVATION_ENABLED": "true"
  },
  "functions": {
    "src/app/api/queues/reward-finality/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "veinvite-reward-finality",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    },
    "src/app/api/queues/reward-reservation/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "veinvite-reward-reservation-finality",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    },
    "src/app/api/queues/sybil-v2-evidence/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "veinvite-sybil-v2-evidence",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/reconcile",
      "schedule": "17 0 * * *"
    },
    {
      "path": "/api/cron/vote-reconcile",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/analytics-maintenance",
      "schedule": "47 0 * * *"
    },
    {
      "path": "/api/cron/sybil-v2-paid-backfill",
      "schedule": "17 1 * * *"
    }
  ]
}
