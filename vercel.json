{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/reconcile",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/analytics-maintenance",
      "schedule": "47 0 * * *"
    }
  ]
}
